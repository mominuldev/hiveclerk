{
  "name": "hiveclerk",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Admin SPA and public widget for Hiveclerk.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.widget.config.ts",
    "build:only": "vite build && vite build --config vite.widget.config.ts",
    "build:widget": "vite build --config vite.widget.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "size": "size-limit",
    "check": "npm run typecheck && npm run lint && npm run test:frontend && npm run verify:assets && npm run size",
    "verify:assets": "node tools/verify-assets.mjs",
    "test:frontend": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "node tools/a11y.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "preact": "^10.29.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-router": "^8.3.0",
    "recharts": "^3.1.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@size-limit/preset-app": "^11.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "size-limit": "^11.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "size-limit": [
    {
      "name": "admin app",
      "path": "assets/admin/assets/*.js",
      "limit": "350 kB",
      "gzip": true
    },
    {
      "name": "public widget",
      "path": "assets/widget/hiveclerk-widget.js",
      "limit": "40 kB",
      "gzip": true
    }
  ],
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
