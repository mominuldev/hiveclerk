{
    "name": "hiveclerk",
    "version": "0.1.0-dev",
    "private": true,
    "type": "module",
    "description": "Admin SPA and public widget for Hiveclerk.",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build && vite build --config vite.widget.config.ts",
        "build:only": "vite build && vite build --config vite.widget.config.ts",
        "build:widget": "vite build --config vite.widget.config.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "size": "size-limit",
        "check": "npm run typecheck && npm run lint && npm run build:only && npm run size"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.0",
        "@hookform/resolvers": "^3.10.0",
        "@tanstack/react-query": "^5.62.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "lucide-react": "^0.469.0",
        "preact": "^10.29.8",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.54.0",
        "react-router-dom": "^7.1.0",
        "recharts": "^3.1.0",
        "tailwind-merge": "^2.6.0",
        "zod": "^3.24.0",
        "zustand": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@size-limit/preset-app": "^11.1.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.0",
        "eslint": "^9.17.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "playwright": "^1.62.1",
        "size-limit": "^11.1.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.19.0",
        "vite": "^6.0.0"
    },
    "size-limit": [
        {
            "name": "admin app",
            "path": "assets/admin/assets/*.js",
            "limit": "350 kB",
            "gzip": true
        },
        {
            "name": "public widget",
            "path": "assets/widget/hiveclerk-widget.js",
            "limit": "40 kB",
            "gzip": true
        }
    ],
    "browserslist": [
        "> 0.5%",
        "last 2 versions",
        "not dead"
    ]
}
